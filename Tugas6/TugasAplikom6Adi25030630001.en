>function ds(t) &= trigreduce(radcan(sqrt(diff(fx(t),t)^2+diff(fy(t),t)^2))); $'ds(t)=ds(t)        
 %image% TugasAplikom6Adi25030630001-160.png
% // latex: {\it ds}\left(t\right)=\sqrt{\left(\frac{d}{d\,t}\,\left(\frac{4\,  \sin t+\cos \left(2\,t\right)-\cos \left(4\,t\right)}{4}\right)(t)  \right)^2+\left(\frac{d}{d\,t}\,\left(\frac{4\,\cos t+\sin \left(2\,  t\right)+\sin \left(4\,t\right)}{4}\right)(t)\right)^2}
>$integrate(ds(x),x,0,2*pi) //panjang (keliling) kurva
 %image% TugasAplikom6Adi25030630001-161.png
% // latex: \int_{0}^{2\,\pi}{\sqrt{\left(\frac{d}{d\,x}\,\left(\frac{4\,\sin x  +\cos \left(2\,x\right)-\cos \left(4\,x\right)}{4}\right)(x)\right)^  2+\left(\frac{d}{d\,x}\,\left(\frac{4\,\cos x+\sin \left(2\,x\right)  +\sin \left(4\,x\right)}{4}\right)(x)\right)^2}\;dx}
>
% Maxima gagal melakukan perhitungan eksak integral tersebut.
%% ==============================================================================
% PENYELESAIAN LENGKAP: PANJANG BUSUR KURVA POLAR
% ==============================================================================
% 1. Bersihkan memori total dari sesi sebelumnya
> reset();
% 2. Definisikan fungsi r, fx, dan fy sebagai ekspresi simbolis murni (tanpa keyword function)
>r &= 1 + sin(3*t)/2;
>fx &= r*cos(t);
>fy &= r*sin(t);
% 3. Hitung elemen panjang busur (dse) secara simbolis menggunakan diff
>dse &= trigreduce(radcan(sqrt(diff(fx,t)^2 + diff(fy,t)^2)));
> $'ds(t)=dse
 %image% TugasAplikom6Adi25030630001-162.png
% // latex: {\it ds}\left(t\right)=\frac{\sqrt{9+4\,\sin \left(3\,t\right)+4\,  \cos \left(6\,t\right)}}{2}
% 4. Konversi ekspresi simbolis ke fungsi numerik EMT agar bisa diintegralkan
>function ds(t) :=sqrt(9 + 4*sin(3*t) + 4*cos(6*t)) / 2;
% 5. Hitung panjang busur (keliling kurva) secara numerik dari 0 sampai 2*pi
>$integrate(dse, t, 0, 2*pi)
 %image% TugasAplikom6Adi25030630001-163.png
% // latex: \frac{\int_{0}^{2\,\pi}{\sqrt{9+4\,\sin \left(3\,t\right)+4\,\cos   \left(6\,t\right)}\;dt}}{2}
> integrate("sqrt(9 + 4*sin(3*x) + 4*cos(6*x)) / 2", 0, 2*pi)
9.0749467823
> 
% 
% Berikut kita hitung integralnya secara numerik dengan perintah EMT.
> integrate("ds(x)",0,2*pi) 
9.0749467823
% Spiral Logaritmik
% 
% latex: x=e^{ax}\cos x,\ y=e^{ax}\sin x.
% %image% TugasAplikom6Adi25030630001-164.png
% // latex: x=e^{ax}\cos x,\ y=e^{ax}\sin x.
>a=0.1; plot2d("exp(a*x)*cos(x)","exp(a*x)*sin(x)",r=2,xmin=0,xmax=2*pi):
 %image% TugasAplikom6Adi25030630001-165.png
>&kill(a) // hapus expresi a

                                 done

