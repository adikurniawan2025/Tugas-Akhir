% 
% * Turunan Fungsi
% 
% Definisi turunan:
% 
% latex: f'(x) = \lim_{h\to 0} \frac{f(x+h)-f(x)}{h}
% %image% TugasAplikom6Adi25030630001-074.png
% // latex: f'(x) = \lim_{h\to 0} \frac{f(x+h)-f(x)}{h}
% 
% Berikut adalah contoh-contoh menentukan turunan fungsi dengan
% menggunakan definisi turunan (limit).
>$showev('limit(((x+h)^2-x^2)/h,h,0)) // turunan x^2
 %image% TugasAplikom6Adi25030630001-075.png
% // latex: \lim_{h\rightarrow 0}{\frac{\left(x+h\right)^2-x^2}{h}}=2\,x
>p &= expand((x+h)^2-x^2)|simplify; $p //pembilang dijabarkan dan disederhanakan
 %image% TugasAplikom6Adi25030630001-076.png
% // latex: 2\,h\,x+h^2
>q &=ratsimp(p/h); $q // ekspresi yang akan dihitung limitnya disederhanakan
 %image% TugasAplikom6Adi25030630001-077.png
% // latex: 2\,x+h
>$limit(q,h,0) // nilai limit sebagai turunan
 %image% TugasAplikom6Adi25030630001-078.png
% // latex: 2\,x
>$showev('limit(((x+h)^n-x^n)/h,h,0)) // turunan x^n
 %image% TugasAplikom6Adi25030630001-079.png
% // latex: \lim_{h\rightarrow 0}{\frac{\left(x+h\right)^{n}-x^{n}}{h}}=n\,x^{n  -1}
% Mengapa hasilnya seperti itu? Tuliskan atau tunjukkan bahwa hasil
% limit tersebut benar, sehingga benar turunan fungsinya benar.  Tulis
% penjelasan Anda di komentar ini.
% 
% Sebagai petunjuk, ekspansikan (x+h)^n dengan menggunakan teorema
% binomial.
% 
% Penjelasan Pembuktian Turunan f(x) = x^n Menggunakan Teorema
% BinomialMenggunakan definisi turunan:
% 
% Berdasarkan Teorema Binomial, ekspansi dari (x+h)^n adalah:
%%  (x+h)^n = x^n + n*x^(n-1)*h + (n*(n-1)/2)*x^(n-2)*h^2 + ... + h^n
% 
% Pembilang ekspresi limit menjadi:
%%  (x+h)^n - x^n = n*x^(n-1)*h + (n*(n-1)/2)*x^(n-2)*h^2 + ... + h^n
%%                = h * [n*x^(n-1) + (n*(n-1)/2)*x^(n-2)*h + ... + h^
% (n-1)]
% 
% Saat dibagi dengan h dan dihitung limit h -> 0:
%%  limit_(h->0) [(x+h)^n - x^n]/h = limit_(h->0) [n*x^(n-1) + (n*(n-
% 1)/2)*x^(n-2)*h + ... + h^(n-1)]
% 
% Karena semua suku setelah suku pertama memiliki faktor h, maka ketika
% h -> 0
%%  nilai suku-suku tersebut menjadi 0, sehingga tersisa n*x^(n-1).
%%  Oleh karena itu, terbukti bahwa turunan dari f(x) = x^n adalah f'(x)
% = n*x^(n-1).
> 
>$showev('limit((sin(x+h)-sin(x))/h,h,0)) // turunan sin(x)
 %image% TugasAplikom6Adi25030630001-080.png
% // latex: \lim_{h\rightarrow 0}{\frac{\sin \left(x+h\right)-\sin x}{h}}=\cos   x
% Mengapa hasilnya seperti itu? Tuliskan atau tunjukkan bahwa hasil
% limit tersebut
%% benar, sehingga benar turunan fungsinya benar.  Tulis penjelasan Anda
% di komentar ini.
% 
% Sebagai petunjuk, ekspansikan sin(x+h) dengan menggunakan rumus jumlah
% dua sudut.
% 
% Penjelasan:
%%  Berdasarkan rumus jumlah dua sudut trigonometri:
%%  sin(x+h) = sin(x)*cos(h) + cos(x)*sin(h)
% 
%  Pembilang ekspresi limit menjadi:
%%  sin(x+h) - sin(x) = sin(x)*cos(h) + cos(x)*sin(h) - sin(x)
%%                    = sin(x)*(cos(h) - 1) + cos(x)*sin(h)
% 
%  Masukkan ke dalam definisi limit turunan:
%%  limit_(h->0) [sin(x+h) - sin(x)] / h
%%    = limit_(h->0) [ sin(x)*(cos(h) - 1)/h + cos(x)*(sin(h)/h) ]
%%    = sin(x) * limit_(h->0) [(cos(h) - 1)/h] + cos(x) * limit_(h->0)
% [sin(h)/h]
% 
%  Menggunakan nilai limit dasar trigonometri:
%%  1. limit_(h->0) sin(h)/h = 1
%%  2. limit_(h->0) (cos(h) - 1)/h = 0
% 
%  Maka diperoleh:
%%    = sin(x) * (0) + cos(x) * (1) = cos(x)
% 
%  Terbukti bahwa turunan dari f(x) = sin(x) adalah f'(x) = cos(x).
>$showev('limit((log(x+h)-log(x))/h,h,0)) // turunan log(x)
 %image% TugasAplikom6Adi25030630001-081.png
% // latex: \lim_{h\rightarrow 0}{\frac{\log \left(x+h\right)-\log x}{h}}=  \frac{1}{x}
% Mengapa hasilnya seperti itu? Tuliskan atau tunjukkan bahwa hasil
% limit tersebut
%% benar, sehingga benar turunan fungsinya benar.  Tulis penjelasan Anda
% di komentar ini.
% 
% Sebagai petunjuk, gunakan sifat-sifat logaritma dan hasil limit pada
% bagian sebelumnya di atas.
% 
% Penejelasan Mengapa Hasil Limit Tersebut d/dx[log(x)] = 1/x:
% 
% 1. Berdasarkan definisi limit turunan:
%%    lim_{h->0} (log(x+h) - log(x)) / h
% 
% 2. Menggunakan sifat pengurangan logaritma: log(a) - log(b) = log(a/b)
%%    = lim_{h->0} (1/h) * log((x+h)/x)
%%    = lim_{h->0} (1/h) * log(1 + h/x)
% 
% 3. Menggunakan sifat pangkat logaritma: c * log(a) = log(a^c)
%%    = lim_{h->0} log(1 + h/x)^(1/h)
% 
% 4. Pemisalan u = h/x  ==>  h = x*u. Saat h -> 0, maka u -> 0.
%%    = lim_{u->0} log(1 + u)^(1/(x*u))
%%    = lim_{u->0} log([ (1 + u)^(1/u) ]^(1/x))
% 
% 5. Karena fungsi logaritma bersifat kontinu, limit masuk ke dalam:
%%    = log( lim_{u->0} (1 + u)^(1/u) )^(1/x)
% 
% 6. Berdasarkan definisi bilangan Euler: lim_{u->0} (1 + u)^(1/u) = e
%%    = log(e^(1/x))
%%    = (1/x) * log(e)
% 
% 7. Karena log(e) = 1 (logaritma natural):
%%    = 1/x
% 
% Kesimpulan: Terbukti bahwa turunan dari log(x) adalah 1/x.
>
>$showev('limit((1/(x+h)-1/x)/h,h,0)) // turunan 1/x
 %image% TugasAplikom6Adi25030630001-082.png
% // latex: \lim_{h\rightarrow 0}{\frac{\frac{1}{x+h}-\frac{1}{x}}{h}}=-\frac{1  }{x^2}
