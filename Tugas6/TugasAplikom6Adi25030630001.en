1.35822987384
>df(xp), f(xp) // cek bahwa f'(xp)=0 dan nilai ekstrim di titik tersebut
0
-5.67530133759
>plot2d(["f(x)","df(x)"],0,2*pi,color=[blue,red]): //grafik fungsi dan turunannya
 %image% TugasAplikom6Adi25030630001-107.png
% Perhatikan titik-titik "puncak" grafik y=f(x) dan nilai turunan pada
% saat grafik fungsinya mencapai titik "puncak" tersebut.
% 
% Penjelasan Analitis Hubungan Titik Puncak f(x) dan Turunannya df(x):
% 
% 1. Hubungan Titik Puncak (Ekstremum) dengan Turunan Pertama:
%%    - Ketika grafik fungsi y = f(x) (kurva biru) mencapai titik
% "puncak"
%%      (baik maksimum lokal maupun minimum lokal), garis singgungnya
% mendatar.
%%    - Hal ini berarti kemiringan (gradien) garis singgung pada titik
% puncak bernilai nol.
% 
% 2. Pengamatan pada Grafik:
%%    - Pada saat kurva f(x) (biru) berada di puncak maksimum (sekitar x
% ˜ 2.8 dan x ˜ 5.8)
%%      maupun puncak minimum (sekitar x ˜ 1.2 dan x ˜ 4.3), grafik
% turunannya df(x) (merah)
%%      tepat memotong sumbu-X (bernilai nol, df(x) = 0).
% 
% 3. Kesimpulan Matematika:
%%    - Syarat stasioner untuk menentukan titik puncak suatu fungsi f(x)
% adalah:
%%      f'(x) = 0  atau  df(x) = 0
%%    - Grafik menunjukkan secara visual bahwa titik stasioner (puncak)
% f(x) selalu
%%      berkorespondensi dengan pembuat nol (titik potong sumbu-X) dari
% fungsi turunannya df(x).
>  
% * Latihan
% 
% Bukalah buku Kalkulus. Cari dan pilih beberapa (paling sedikit 5
% fungsi berbeda tipe/bentuk/jenis) fungsi dari buku tersebut, kemudian
% definisikan di EMT pada baris-baris perintah berikut (jika perlu
% tambahkan lagi). Untuk setiap fungsi, tentukan turunannya dengan
% menggunakan definisi turunan (limit), menggunakan perintah diff, dan
% secara manual (langkah demi langkah yang dihitung dengan Maxima)
% seperti contoh-contoh di atas. Gambar grafik fungsi asli dan fungsi
% turunannya pada sumbu koordinat yang sama.
% 
% 
%  1. FUNGSI POLINOMIAL: f(x) = 2*x^3 - 3*x^2 + 5
>function f1(x) := 2*x^3 - 3*x^2 + 5
% a. Menggunakan definisi limit
>$showev('limit((2*(x+h)^3 - 3*(x+h)^2 + 5 - (2*x^3 - 3*x^2 + 5))/h, h, 0))
 %image% TugasAplikom6Adi25030630001-108.png
% // latex: \lim_{h\rightarrow 0}{\frac{2\,\left(x+h\right)^3-3\,\left(x+h  \right)^2-2\,x^3+3\,x^2}{h}}=6\,x^2-6\,x
% b. Menggunakan perintah diff
>$showev('diff(2*x^3 - 3*x^2 + 5, x))
 %image% TugasAplikom6Adi25030630001-109.png
% // latex: \frac{d}{d\,x}\,\left(2\,x^3-3\,x^2+5\right)=6\,x^2-6\,x
% c. Langkah manual
>&define(f1(x), 2*x^3 - 3*x^2 + 5);
>$showev('diff(f1(x), x))
 %image% TugasAplikom6Adi25030630001-110.png
% // latex: \frac{d}{d\,x}\,\left(2\,x^3-3\,x^2+5\right)=6\,x^2-6\,x
% d. Plot grafik fungsi asli dan turunannya
>plot2d(["2*x^3 - 3*x^2 + 5", "6*x^2 - 6*x"], -2, 2, color=[blue, red], grid=1, title="1. Polinomial: f(x) dan f'(x)");
% 2. FUNGSI RASIONAL: f(x) = (x + 1)/(x - 2)
>function f2(x) := (x + 1)/(x - 2)
% a. Menggunakan definisi limit
>$showev('limit((((x+h)+1)/((x+h)-2) - (x+1)/(x-2))/h, h, 0))
 %image% TugasAplikom6Adi25030630001-111.png
% // latex: \lim_{h\rightarrow 0}{\frac{\frac{x+h+1}{x+h-2}-\frac{x+1}{x-2}}{h}  }=-\frac{3}{x^2-4\,x+4}
% b. Menggunakan perintah diff
>$showev('diff((x + 1)/(x - 2), x))
 %image% TugasAplikom6Adi25030630001-112.png
% // latex: \frac{d}{d\,x}\,\left(\frac{x+1}{x-2}\right)=\frac{1}{x-2}-\frac{x+  1}{\left(x-2\right)^2}
% c. Langkah manual
>&u: x + 1; &v: x - 2;
>$showev(('diff(u,x)*v - u*'diff(v,x))/v^2)
 %image% TugasAplikom6Adi25030630001-113.png
% // latex: \frac{\left(x-2\right)\,\left(\frac{d}{d\,x}\,\left(x+1\right)  \right)-\left(x+1\right)\,\left(\frac{d}{d\,x}\,\left(x-2\right)  \right)}{\left(x-2\right)^2}=-\frac{3}{\left(x-2\right)^2}
% d. Plot grafik fungsi asli dan turunannya 
> plot2d(["(x+1)/(x-2)", "-3/(x-2)^2"], -3, 5, c=-10, d=10, color=[blue, red], grid=1, title="2. Rasional");
% 3. FUNGSI TRIGONOMETRI: f(x) = sin(2*x)
> function f3(x) := sin(2*x)
% a. Menggunakan definisi limit
>$showev('limit((sin(2*(x+h)) - sin(2*x))/h, h, 0))
 %image% TugasAplikom6Adi25030630001-114.png
% // latex: \lim_{h\rightarrow 0}{\frac{\sin \left(2\,\left(x+h\right)\right)-  \sin \left(2\,x\right)}{h}}=2\,\cos \left(2\,x\right)
% b. Menggunakan perintah diff
>$showev('diff(sin(2*x), x))
 %image% TugasAplikom6Adi25030630001-115.png
% // latex: \frac{d}{d\,x}\,\sin \left(2\,x\right)=2\,\cos \left(2\,x\right)
% c. Langkah manual
>remvalue u; &depends(u, x);
>$showev('diff(sin(u), u) * 'diff(2*x, x))
 %image% TugasAplikom6Adi25030630001-116.png
% // latex: \frac{d}{d\,u}\,\sin u\,\left(\frac{d}{d\,x}\,\left(2\,x\right)  \right)=2\,\cos u
>$showev(subst(u=2*x, 2*cos(u)))
 %image% TugasAplikom6Adi25030630001-117.png
% // latex: 2\,\cos \left(2\,x\right)=2\,\cos \left(2\,x\right)
% d. Plot grafik fungsi asli dan turunannya
>plot2d(["sin(2*x)", "2*cos(2*x)"], 0, 2*pi, color=[blue, red], grid=1, title="3. Trigonometri: f(x) dan f'(x)");
% 4. FUNGSI EKSPONENSIAL: f(x) = %e^(3*x)
>function f4(x) := exp(3*x)
% a. Menggunakan definisi limit
>$&'limit((%e^(3*(x+h)) - %e^(3*x))/h, h, 0) = 3*%e^(3*x)
 %image% TugasAplikom6Adi25030630001-118.png
% // latex: \lim_{h\rightarrow 0}{\frac{e^{3\,\left(x+h\right)}-e^{3\,x}}{h}}=3  \,e^{3\,x}
>  
% b. Perintah diff
>$showev('diff(%e^(3*x), x))
 %image% TugasAplikom6Adi25030630001-119.png
% // latex: \frac{d}{d\,x}\,e^{3\,x}=3\,e^{3\,x}
% c. Langkah manual
>$showev('diff(%e^u, u) * 'diff(3*x, x))
 %image% TugasAplikom6Adi25030630001-120.png
% // latex: \frac{d}{d\,u}\,e^{u}\,\left(\frac{d}{d\,x}\,\left(3\,x\right)  \right)=3\,e^{u}
% d. Plot grafik
>plot2d(["exp(3*x)", "3*exp(3*x)"], -1, 1, color=[blue, red], grid=1, title="4. Eksponensial");
% 5. FUNGSI LOGARITMA NATURAL: f(x) = log(x^2 + 1)
>&assume(x>0);
>function f5(x) := log(x^2 + 1)
% a. Menggunakan definisi limit
>$showev('limit((log((x+h)^2 + 1) - log(x^2 + 1))/h, h, 0))
 %image% TugasAplikom6Adi25030630001-121.png
% // latex: \lim_{h\rightarrow 0}{\frac{\log \left(\left(x+h\right)^2+1\right)-  \log \left(x^2+1\right)}{h}}=\frac{2\,x}{x^2+1}
% b. Menggunakan perintah diff
>$showev('diff(log(x^2 + 1), x))
 %image% TugasAplikom6Adi25030630001-122.png
% // latex: \frac{d}{d\,x}\,\log \left(x^2+1\right)=\frac{2\,x}{x^2+1}
% c. Langkah manual
>remvalue u;
>$showev('diff(log(u), u) * 'diff(x^2 + 1, x))
 %image% TugasAplikom6Adi25030630001-123.png
% // latex: \frac{d}{d\,u}\,\log u\,\left(\frac{d}{d\,x}\,\left(x^2+1\right)  \right)=\frac{2\,x}{u}
>$showev(subst(u=x^2+1, (1/u)*(2*x)))
 %image% TugasAplikom6Adi25030630001-124.png
% // latex: \frac{2\,x}{x^2+1}=\frac{2\,x}{x^2+1}
% d. Plot grafik
>plot2d(["log(x^2 + 1)", "(2*x)/(x^2 + 1)"], -3, 3, color=[blue, red], grid=1, title="5. Logaritma: f(x) dan f'(x)");
% * Integral
% 
% EMT dapat digunakan untuk menghitung integral, baik integral tak tentu
% maupun integral tentu. Untuk integral tak tentu (simbolik) sudah tentu
% EMT menggunakan Maxima, sedangkan untuk perhitungan integral tentu EMT
% sudah menyediakan beberapa fungsi yang mengimplementasikan algoritma
% kuadratur (perhitungan integral tentu menggunakan metode numerik).
% 
% Pada notebook ini akan ditunjukkan perhitungan integral tentu dengan
% menggunakan Teorema Dasar Kalkulus:
% 
% latex: \int_a^b f(x)\ dx = F(b)-F(a), \quad \text{ dengan  } F'(x) = f(x).
% %image% TugasAplikom6Adi25030630001-125.png
% // latex: \int_a^b f(x)\ dx = F(b)-F(a), \quad \text{ dengan  } F'(x) = f(x).
% 
% Fungsi untuk menentukan integral adalah integrate. Fungsi ini dapat
% digunakan untuk menentukan, baik integral tentu maupun tak tentu (jika
% fungsinya memiliki antiderivatif). Untuk perhitungan integral tentu
% fungsi integrate menggunakan metode numerik (kecuali fungsinya tidak
% integrabel, kita tidak akan menggunakan metode ini).
>$showev('integrate(x^n,x))
Answering "Is n equal to -1?" with "no"
 %image% TugasAplikom6Adi25030630001-126.png
% // latex: \int {x^{n}}{\;dx}=\frac{x^{n+1}}{n+1}
>$showev('integrate(1/(1+x),x))
 %image% TugasAplikom6Adi25030630001-127.png
% // latex: \int {\frac{1}{x+1}}{\;dx}=\log \left(x+1\right)
>$showev('integrate(1/(1+x^2),x))
 %image% TugasAplikom6Adi25030630001-128.png
% // latex: \int {\frac{1}{x^2+1}}{\;dx}=\arctan x
>$showev('integrate(1/sqrt(1-x^2),x))
 %image% TugasAplikom6Adi25030630001-129.png
% // latex: \int {\frac{1}{\sqrt{1-x^2}}}{\;dx}=\arcsin x
>$showev('integrate(sin(x),x,0,pi))
 %image% TugasAplikom6Adi25030630001-130.png
% // latex: \int_{0}^{\pi}{\sin x\;dx}=2
