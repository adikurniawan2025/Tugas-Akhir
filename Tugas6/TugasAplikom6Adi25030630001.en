>
% ** Kurvatur (Kelengkungan) Kurva
% 
% image: Osculating.png
% 
% Aslinya, kelengkungan kurva diferensiabel (yakni, kurva mulus yang tidak lancip) di titik P didefinisikan melalui lingkaran
% oskulasi (yaitu, lingkaran yang melalui titik P dan terbaik memperkirakan, paling banyak menyinggung kurva di sekitar P). Pusat
% dan radius kelengkungan kurva di P adalah pusat dan radius lingkaran oskulasi. Kelengkungan adalah kebalikan dari radius
% kelengkungan:
% 
% latex: \kappa =\frac {1}{R}
% 
% dengan R adalah radius kelengkungan. (Setiap lingkaran memiliki kelengkungan ini pada setiap titiknya, dapat diartikan, setiap
% lingkaran berputar 2pi sejauh 2piR.)
%% Definisi ini sulit dimanipulasi dan dinyatakan ke dalam rumus untuk kurva umum. Oleh karena itu digunakan definisi lain yang
% ekivalen.
% 
% ** Definisi Kurvatur dengan Fungsi Parametrik Panjang Kurva
%% Setiap kurva diferensiabel dapat dinyatakan dengan persamaan parametrik terhadap panjang kurva s:
% 
% latex: \gamma(s) = (x(s),\ y(s)),
% 
% dengan x dan y adalah fungsi riil yang diferensiabel, yang memenuhi:
% 
% latex: \|\gamma'(s)\|=\sqrt{x'(s)^2+y'(s)^2}=1.
% 
% 
% Ini berarti bahwa vektor singgung
% 
% 
% latex: \mathbf{T}(s)=(x'(s),\ y'(s))
% 
% 
% memiliki norm 1 dan merupakan vektor singgung satuan.
% 
% Apabila kurvanya memiliki turunan kedua, artinya turunan kedua x dan y ada, maka T'(s) ada. Vektor ini merupakan normal kurva yang
% arahnya menuju pusat kurvatur, norm-nya merupakan nilai kurvatur (kelengkungan):
% 
% latex:  \begin{aligned}\mathbf{T}(s) &= \mathbf{\gamma}'(s),\\ \mathbf{T}^{2}(s) &=1\ \text{(konstanta)}\Rightarrow \mathbf{T}'(s)\cdot \mathbf{T}(s)=0\\ \kappa(s) &=\|\mathbf {T}'(s)\|= \|\mathbf{\gamma}''(s)\|=\sqrt{x''(s)^{2}+y''(s)^{2}}.\end{aligned}
% 
% Nilai
% 
% latex: R(s)=\frac{1}{\kappa(s)}
% 
% disebut jari-jari (radius) kelengkungan kurva.
% 
% Bilangan riil
% 
% latex:  k(s) = \pm\kappa(s)
% 
% disebut nilai kelengkungan bertanda.
% 
% Contoh:
%% Akan ditentukan kurvatur lingkaran
% 
% latex: x=r\cos t,\ y= r\sin t.
>fx &= r*cos(t); fy &=r*sin(t);
>&assume(t>0,r>0); s &=integrate(sqrt(diff(fx,t)^2+diff(fy,t)^2),t,0,t); s // elemen panjang kurva, panjang busur lingkaran (s)

                                 r t

>&kill(s); fx &= r*cos(s/r); fy &=r*sin(s/r); // definisi ulang persamaan parametrik terhadap s dengan substitusi t=s/r
>k &= trigsimp(sqrt(diff(fx,s,2)^2+diff(fy,s,2)^2)); $k // nilai kurvatur lingkaran dengan menggunakan definisi di atas
 %image% TugasAplikom6Adi25030630001-198.png
% // latex: \frac{1}{r}
>
% Untuk representasi parametrik umum, misalkan
% 
% latex: x = x(t),\ y= y(t)
% 
% merupakan persamaan parametrik untuk kurva bidang yang terdiferensialkan dua kali. Kurvatur untuk kurva tersebut didefinisikan
% sebagai
% 
% latex: \begin{aligned}\kappa &= \frac{d\phi}{ds}=\frac{\frac{d\phi}{dt}}{\frac{ds}{dt}}\quad (\phi \text{ adalah sudut kemiringan garis singgung dan }s \text{ adalah panjang kurva})\\ &=\frac{\frac{d\phi}{dt}}{\sqrt{(\frac{dx}{dt})^2+(\frac{dy}{dt})^2}}= \frac{\frac{d\phi}{dt}}{\sqrt{x'(t)^2+y'(t)^2}}.\end{aligned}.
% 
% Selanjutnya, pembilang pada persamaan di atas dapat dicari sebagai berikut.
% 
% latex: \begin{aligned}\sec^2\phi\frac{d\phi}{dt} &= \frac{d}{dt}\left(\tan\phi\right)= \frac{d}{dt}\left(\frac{dy}{dx}\right)= \frac{d}{dt}\left(\frac{dy/dt}{dx/dt}\right)= \frac{d}{dt}\left(\frac{y'(t)}{x'(t)}\right)=\frac{x'(t)y''(t)-x''(t)y'(t)}{x'(t)^2}.\\ & \\ \frac{d\phi}{dt} &= \frac{1}{\sec^2\phi}\frac{x'(t)y''(t)-x''(t)y'(t)}{x'(t)^2}\\ &= \frac{1}{1+\tan^2\phi}\frac{x'(t)y''(t)-x''(t)y'(t)}{x'(t)^2}\\ &= \frac{1}{1+\left(\frac{y'(t)}{x'(t)}\right)^2}\frac{x'(t)y''(t)-x''(t)y'(t)}{x'(t)^2}\\ &= \frac{x'(t)y''(t)-x''(t)y'(t)}{x'(t)^2+y'(t)^2}.\end{aligned}
% 
% Jadi, rumus kurvatur untuk kurva parametrik
% 
% latex: x=x(t),\ y=y(t)
% 
% adalah
% 
% latex: \kappa(t) = \frac{x'(t)y''(t)-x''(t)y'(t)}{\left(x'(t)^2+y'(t)^2\right)^{3/2}}.
>
% Jika kurvanya dinyatakan dengan persamaan parametrik pada koordinat
% kutub
% 
% latex: x=r(\theta)\cos\theta,\ y=r(\theta)\sin\theta,
% %image% TugasAplikom6Adi25030630001-199.png
% // latex: x=r(\theta)\cos\theta,\ y=r(\theta)\sin\theta,
% 
% maka rumus kurvaturnya adalah
% 
% latex: \kappa(\theta) = \frac{r(\theta)^2+2r'(\theta)^2-r(\theta)r''(\theta)}{\left(r'(\theta)^2+r'(\theta)^2\right)^{3/2}}.
% %image% TugasAplikom6Adi25030630001-200.png
% // latex: \kappa(\theta) = \frac{r(\theta)^2+2r'(\theta)^2-r(\theta)r''(\theta)}{\left(r'(\theta)^2+r'(\theta)^2\right)^{3/2}}.
% 
% (Silakan Anda turunkan rumus tersebut!)
% 
% Contoh:
%% Lingkaran dengan pusat (0,0) dan jari-jari r dapat dinyatakan dengan
% persamaan parametrik
% 
% latex: x=r\cos t,\ y=r\sin t.
% %image% TugasAplikom6Adi25030630001-201.png
% // latex: x=r\cos t,\ y=r\sin t.
% 
% Nilai kelengkungan lingkaran tersebut adalah
% 
% latex: \kappa(t)=\frac{x'(t)y''(t)-x''(t)y'(t)}{\left(x'(t)^2+y'(t)^2\right)^{3/2}}=\frac{r^2}{r^3}=\frac 1 r.
% %image% TugasAplikom6Adi25030630001-202.png
% // latex: \kappa(t)=\frac{x'(t)y''(t)-x''(t)y'(t)}{\left(x'(t)^2+y'(t)^2\right)^{3/2}}=\frac{r^2}{r^3}=\frac 1 r.
% 
% Hasil cocok dengan definisi kurvatur suatu kelengkungan.
>
% Kurva
% 
% latex: y=f(x)
% %image% TugasAplikom6Adi25030630001-203.png
% // latex: y=f(x)
% 
% dapat dinyatakan ke dalam persamaan parametrik
% 
% latex: x=t,\ y=f(t),\ \text{ dengan } x'(t)=1,\ x''(t)=0,
% %image% TugasAplikom6Adi25030630001-204.png
% // latex: x=t,\ y=f(t),\ \text{ dengan } x'(t)=1,\ x''(t)=0,
% 
% sehingga kurvaturnya adalah
% 
% latex: \kappa(t) = \frac{y''(t)}{\left(1+y'(t)^2\right)^{3/2}}.
% %image% TugasAplikom6Adi25030630001-205.png
% // latex: \kappa(t) = \frac{y''(t)}{\left(1+y'(t)^2\right)^{3/2}}.
% 
% Contoh:
%% Akan ditentukan kurvatur parabola
% 
% latex: y=ax^2+bx+c.
% %image% TugasAplikom6Adi25030630001-206.png
% // latex: y=ax^2+bx+c.
>function f(x) &= a*x^2+b*x+c; $y=f(x)
 %image% TugasAplikom6Adi25030630001-207.png
% // latex: y=a\,x^2+b\,x+c
>function k(x) &= (diff(f(x),x,2))/(1+diff(f(x),x)^2)^(3/2); $'k(x)=k(x) // kelengkungan parabola 
 %image% TugasAplikom6Adi25030630001-208.png
% // latex: k\left(x\right)=\frac{2\,a}{\left(\left(2\,a\,x+b\right)^2+1\right)  ^{\frac{3}{2}}}
>function f(x) &= x^2+x+1; $y=f(x) // akan kita plot kelengkungan parabola untuk a=b=c=1
 %image% TugasAplikom6Adi25030630001-209.png
% // latex: y=x^2+x+1
>function k(x) &= (diff(f(x),x,2))/(1+diff(f(x),x)^2)^(3/2); $'k(x)=k(x) // kelengkungan parabola 
 %image% TugasAplikom6Adi25030630001-210.png
% // latex: k\left(x\right)=\frac{2}{\left(\left(2\,x+1\right)^2+1\right)^{  \frac{3}{2}}}
% Berikut kita gambar parabola tersebut beserta kurva kelengkungan, kurva jari-jari kelengkungan dan salah satu lingkaran oskulasi
% di titik puncak parabola. Perhatikan, puncak parabola dan jari-jari lingkaran oskulasi di puncak parabola adalah
% 
% latex: (-1/2,3/4),\ 1/k(2)=1/2,
% 
% sehingga pusat lingkaran oskulasi adalah (-1/2, 5/4).
>plot2d(["f(x)", "k(x)"],-2,1, color=[blue,red]); plot2d("1/k(x)",-1.5,1,color=green,>add); ...
>plot2d("-1/2+1/k(-1/2)*cos(x)","5/4+1/k(-1/2)*sin(x)",xmin=0,xmax=2pi,>add,color=blue):
 %image% TugasAplikom6Adi25030630001-211.png
% Untuk kurva yang dinyatakan dengan fungsi implisit
% 
% latex: F(x,y)=0
% 
% dengan turunan-turunan parsial
% 
% latex: F_x=\frac{\partial F}{\partial x},\ F_y=\frac{\partial F}{\partial y},\ F_{xy}=\frac{\partial}{\partial y}\left(\frac{\partial F}{\partial x}\right),\ F_{xx}=\frac{\partial}{\partial x}\left(\frac{\partial F}{\partial x}\right),\ F_{yy}=\frac{\partial}{\partial y}\left(\frac{\partial F}{\partial y}\right),
% 
% berlaku
% 
% latex: F_x dx+ F_y dy = 0\text{ atau } \frac{dy}{dx}=-\frac{F_x}{F_y},
% 
% sehingga kurvaturnya adalah
% 
% latex: \kappa =\frac {F_y^2F_{xx}-2F_xF_yF_{xy}+F_x^2F_{yy}}{\left(F_x^2+F_y^2\right)^{3/2}}.
% 
% (Silakan Anda turunkan sendiri!)
% 
% Contoh 1:
%% Parabola 
% 
% latex: y=ax^2+bx+c
% 
% dapat dinyatakan ke dalam persamaan implisit
% 
% latex: ax^2+bx+c-y=0.
>function F(x,y) &=a*x^2+b*x+c-y; $F(x,y)
 %image% TugasAplikom6Adi25030630001-212.png
% // latex: -y+a\,x^2+b\,x+c
>Fx &= diff(F(x,y),x), Fxx &=diff(F(x,y),x,2), Fy &=diff(F(x,y),y), Fxy &=diff(diff(F(x,y),x),y), Fyy &=diff(F(x,y),y,2)  

                              2 a x + b


                                 2 a


                                 - 1


                                  0


                                  0

>function k(x) &= (Fy^2*Fxx-2*Fx*Fy*Fxy+Fx^2*Fyy)/(Fx^2+Fy^2)^(3/2); $'k(x)=k(x) // kurvatur parabola tersebut
 %image% TugasAplikom6Adi25030630001-213.png
% // latex: k\left(x\right)=\frac{2\,a}{\left(\left(2\,a\,x+b\right)^2+1\right)  ^{\frac{3}{2}}}
% Hasilnya sama dengan sebelumnya yang menggunakan persamaan parabola biasa.
>
% * Latihan
% 
% - Bukalah buku Kalkulus.
%% - Cari dan pilih beberapa (paling sedikit 5 fungsi berbeda tipe/bentuk/jenis) fungsi dari buku tersebut, kemudian definisikan di
% EMT pada baris-baris perintah berikut (jika perlu tambahkan lagi).
%% - Untuk setiap fungsi, tentukan anti turunannya (jika ada), hitunglah integral tentu dengan batas-batas yang menarik (Anda
% tentukan sendiri), seperti contoh-contoh tersebut.
%% - Lakukan hal yang sama untuk fungsi-fungsi yang tidak dapat diintegralkan (cari sedikitnya 3 fungsi).
%% - Gambar grafik fungsi dan daerah integrasinya pada sumbu koordinat yang sama.
%% - Gunakan integral tentu untuk mencari luas daerah yang dibatasi oleh dua kurva yang berpotongan di dua titik. (Cari dan gambar
% kedua kurva dan arsir (warnai) daerah yang dibatasi oleh keduanya.)
%% - Gunakan integral tentu untuk menghitung volume benda putar kurva y= f(x) yang diputar mengelilingi sumbu x dari x=a sampai x=b,
% yakni
% 
% latex: V = \int_a^b \pi (f(x)^2\ dx.
% 
% (Pilih fungsinya dan gambar kurva dan benda putar yang dihasilkan. Anda dapat mencari contoh-contoh bagaimana cara menggambar
% benda hasil perputaran suatu kurva.)
%% - Gunakan integral tentu untuk menghitung panjang kurva y=f(x) dari x=a sampai x=b dengan menggunakan rumus:
% 
% latex: S = \int_a^b \sqrt{1+(f'(x))^2} \ dx.
% 
% (Pilih fungsi dan gambar kurvanya.)
%% - Apabila fungsi dinyatakan dalam koordinat kutub x=f(r,t), y=g(r,t), r=h(t), x=a bersesuaian dengan t=t0 dan x=b bersesuian
% dengan t=t1, maka rumus di atas akan menjadi:
% 
% latex: S=\int_{t_0}^{t_1} \sqrt{x'(t)^2+y'(t)^2}\ dt.
% 
% - Pilih beberapa kurva menarik (selain lingkaran dan parabola) dari buku  kalkulus. Nyatakan setiap kurva tersebut dalam bentuk:
%%   a. koordinat Kartesius (persamaan y=f(x))
%%   b. koordinat kutub ( r=r(theta))
%%   c. persamaan parametrik x=x(t), y=y(t)
%%   d. persamaan implit F(x,y)=0
%% - Tentukan kurvatur masing-masing kurva dengan menggunakan keempat representasi tersebut (hasilnya harus sama).
%% - Gambarlah kurva asli, kurva kurvatur, kurva jari-jari lingkaran oskulasi, dan salah satu lingkaran oskulasinya.
>
% ==============================================================================
% LEMBAR KERJA EULER MATH TOOLBOX (EMT): LATIHAN KALKULUS INTEGRASI
% ==============================================================================
>reset();
% ------------------------------------------------------------------------------
% NO 1. DEFINISI & INTEGRASI 5 FUNGSI BERBEDA (BISA DIINTEGRALKAN)
% ------------------------------------------------------------------------------
% Fungsi 1: Polinomial f1(x) = x^3 - 3*x
>f1 &= x^3 - 3*x;
>$'anti_f1 = integrate(f1, x)
 %image% TugasAplikom6Adi25030630001-214.png
% // latex: {\it anti\_\_f_1}=\frac{x^4}{4}-\frac{3\,x^2}{2}
>hasil1 &= integrate(f1, x, 0, 2);
>$hasil1
 %image% TugasAplikom6Adi25030630001-215.png
% // latex: -2
% Fungsi 2: Trigonometri f2(x) = sin(x)*cos(x)
>f2 &= sin(x)*cos(x);
>$'anti_f2 = integrate(f2, x)
 %image% TugasAplikom6Adi25030630001-216.png
% // latex: {\it anti\_\_f_2}=-\frac{\cos ^2x}{2}
>hasil2 &= integrate(f2, x, 0, pi/2);
>$hasil2
 %image% TugasAplikom6Adi25030630001-217.png
% // latex: \frac{1}{2}
% Fungsi 3: Eksponensial f3(x) = x*exp(x)
>f3 &= x*exp(x);
>$'anti_f3 = integrate(f3, x)
 %image% TugasAplikom6Adi25030630001-218.png
% // latex: {\it anti\_\_f_3}=\left(x-1\right)\,e^{x}
>hasil3 &= integrate(f3, x, 0, 1);
>$hasil3
 %image% TugasAplikom6Adi25030630001-219.png
% // latex: 1
% Fungsi 4: Rasional f4(x) = 1/(x^2 + 1)
>f4 &= 1/(x^2 + 1);
>$'anti_f4 = integrate(f4, x)
 %image% TugasAplikom6Adi25030630001-220.png
% // latex: {\it anti\_\_f_4}=\arctan x
>hasil4 &= integrate(f4, x, 0, 1);
>$hasil4
 %image% TugasAplikom6Adi25030630001-221.png
% // latex: \frac{\pi}{4}
% Fungsi 5: Logaritma f5(x) = log(x)
>f5 &= log(x);
>$'anti_f5 = integrate(f5, x)
 %image% TugasAplikom6Adi25030630001-222.png
% // latex: {\it anti\_\_f_5}=x\,\log x-x
>hasil5 &= integrate(f5, x, 1, e);
Answering "Is e-1 positive, negative or zero?" with "positive"
>$hasil5
 %image% TugasAplikom6Adi25030630001-223.png
% // latex: e\,\log e-e+1
% ------------------------------------------------------------------------------
% NO 2. FUNGSI YANG TIDAK MEMILIKI ANTI-TURUNAN ELEMENTER (3 FUNGSI)
% ------------------------------------------------------------------------------
% Menggunakan metode integrasi numerik bawaan EMT (romberg / integrate numerik)
% Fungsi A: fA(x) = exp(-x^2) [Fungsi Gaussi]
>fA &= exp(-x^2);
>romberg("exp(-x^2)", 0, 1)
0.746824132814
% Fungsi B: fB(x) = sin(x)/x [Fungsi Sinc]
>fB &= sin(x)/x;
>romberg("sin(x)/x", 0.000001, pi)
1.85193605198
% Fungsi C: fC(x) = sqrt(1 + x^4)
>fC &= sqrt(1 + x^4);
>romberg("sqrt(1 + x^4)", 0, 1)
1.08942941322
% ------------------------------------------------------------------------------
% NO 3. GRAFIK FUNGSI DAN DAERAH INTEGRASINYA
% ------------------------------------------------------------------------------
% Menggambar f1(x) = x^3 - 3*x pada rentang [0, 2] beserta daerah arsirnya
>reset();
>plot2d("x^3 - 3*x", 0, 2); ...
>plot2d("x^3 - 3*x", 0, 2, >filled, color=lightgray, >add);
% ------------------------------------------------------------------------------
% NO 4. LUAS DAERAH DIBATASI DUA KURVA BERSILANGAN
% ------------------------------------------------------------------------------
% Kurva y1 = x^2 dan y2 = x + 2 (Berpotongan di x = -1 dan x = 2)
>reset();
>y1 &= x^2; y2 &= x + 2;
>Luas &= integrate(y2 - y1, x, -1, 2)

                                  9
                                  -
                                  2

% Plot dua kurva dan daerah di antaranya
>plot2d(["x^2", "x + 2"], -2, 3, color=[blue, red]); ...
>plot2d("x + 2", -1, 2, >filled, fillcolor=lightgray, >add); ...
>plot2d("x^2", -1, 2, >filled, fillcolor=white, >add); ...
>plot2d(["x^2", "x + 2"], -2, 3, color=[blue, red], >add);
% ------------------------------------------------------------------------------
% NO 5. VOLUME BENDA PUTAR MEMENGELILINGI SUMBU X
% ------------------------------------------------------------------------------
% Kurva f(x) = sqrt(x) diputar mengelilingi sumbu x dari x = 0 sampai x = 4
% Rumus: V = pi * integrate(f(x)^2, x, a, b)
>reset();
>f &= sqrt(x);
>Volume &= pi * integrate(f^2, x, 0, 4)

                                 8 pi

% Gambar kurva 2D pembentuknya
>plot2d("sqrt(x)", 0, 4);
% ------------------------------------------------------------------------------
% NO 6. PANJANG KURVA KOORDINAT KARTESIUS y = f(x)
% ------------------------------------------------------------------------------
% Kurva y = (2/3)*x^(3/2) dari x = 0 sampai x = 3
% Rumus: S = integrate(sqrt(1 + (f'(x))^2), x, a, b)
>reset();
>fy &= (2/3)*x^(3/2);
>dfy &= diff(fy, x);
>dS &= radcan(sqrt(1 + dfy^2));
>PanjangKartesius &= integrate(dS, x, 0, 3)

                                  14
                                  --
                                  3

% ------------------------------------------------------------------------------
% NO 7. PANJANG KURVA KOORDINAT KUTUB (POLAR)
% ------------------------------------------------------------------------------
% Kurva Kardioida: r(t) = 1 + cos(t) dari t = 0 sampai t = 2*pi
% Rumus: S = integrate(sqrt(x'(t)^2 + y'(t)^2), t, t0, t1)
>reset();
>rt &= 1 + cos(t);
>xt &= rt * cos(t);
>yt &= rt * sin(t);
>dSpolar &= trigreduce(radcan(sqrt(diff(xt,t)^2 + diff(yt,t)^2)));
>PanjangPolar &= integrate(dSpolar, t, 0, 2*pi)

                                  8

% ------------------------------------------------------------------------------
% NO 8. REPRESENSI KURVA MENARIK (ASTROID) DALAM 4 BENTUK
% ------------------------------------------------------------------------------
>reset();
% a. Koordinat Kartesius: y = (1 - x^(2/3))^(3/2) 
>yatas &= (1 - abs(x)^(2/3))^(3/2);
>$'y_atas = y_atas
 %image% TugasAplikom6Adi25030630001-224.png
% // latex: {\it y\_\_atas}={\it y\_\_atas}
>ybawah &= -(1 - abs(x)^(2/3))^(3/2);
>$'y_bawah = y_bawah
 %image% TugasAplikom6Adi25030630001-225.png
% // latex: {\it y\_\_bawah}={\it y\_\_bawah}
>plot2d("(1 - abs(x)^(2/3))^(3/2)", -1, 1, square=1, color=blue);
>plot2d("-(1 - abs(x)^(2/3))^(3/2)", -1, 1, >add, color=blue);
% b. Koordinat Kutub: r(theta) = cos(theta)*sin(theta) (Bentuk turunan) 
>reset();
>t = linspace(0, 2*pi, 1000);
>r = 1 ./ (abs(cos(t)).^(2/3) + abs(sin(t)).^(2/3)).^(3/2);
>x = r .* cos(t);
>y = r .* sin(t);
>plot2d(x, y, square=1, color=red);  
% c. Persamaan Parametrik: x(t) = cos(t)^3, y(t) = sin(t)^3
>xt &= cos(t)^3; 
