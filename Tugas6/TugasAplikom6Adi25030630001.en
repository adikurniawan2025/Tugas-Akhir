% // latex: \lim_{h\rightarrow 0}{\frac{\left(x+h\right)^{x+h}-x^{x}}{h}}=x^{x}  \,\left(\log x+1\right)
% Mengapa hasilnya seperti itu? Tuliskan atau tunjukkan bahwa hasil
% limit tersebut benar, sehingga benar turunan fungsinya benar. Tulis
% penjelasan Anda di komentar ini.
% 
% Penjelasan Analitis Hasil Limit Turunan f(x) = x^x:
% 
% 1. Definisi Fungsi dan Logaritma Natural:
%%    Misalkan y = f(x) = x^x.
%%    Untuk menurunkan fungsi eksponensial dengan basis dan pangkat
% berupa variabel,
%%    kita gunakan turunan logaritmik dengan mengenakan logaritma natural
% (ln) di kedua sisi:
%%    ln(y) = ln(x^x) = x * ln(x)
% 
% 2. Turunan Implisit terhadap x:
%%    Turunkan kedua sisi terhadap x menggunakan aturan rantai dan aturan
% perkalian:
%%    (1/y) * (dy/dx) = (d/dx [x]) * ln(x) + x * (d/dx [ln(x)])
%%    (1/y) * (dy/dx) = 1 * ln(x) + x * (1/x)
%%    (1/y) * (dy/dx) = ln(x) + 1
% 
% 3. Substitusi Kembali Nilai y = x^x:
%%    dy/dx = y * (ln(x) + 1)
%%    dy/dx = x^x * (ln(x) + 1)
% 
% 4. Hubungan dengan Limit Turunan:
%%    Berdasarkan definisi limit turunan f'(x):
%%    lim_{h->0} ((x+h)^(x+h) - x^x) / h = f'(x)
% 
%    Karena f'(x) = x^x * (ln(x) + 1), maka nilai limit tersebut
% terbukti sama dengan:
%%    x^x * (log(x) + 1)  [Di Maxima/EMT, log(x) menyatakan logaritma
% natural / ln(x)]
>&forget(x>0) // jangan lupa, lupakan asumsi untuk kembali ke semula

                               [x > 0]

>&forget(x<0)

                               [x < 0]

>&facts()

