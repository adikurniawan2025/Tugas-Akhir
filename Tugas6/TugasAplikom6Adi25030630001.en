% Soal:
% 
% Tunjukkan bahwa keliling lingkaran dengan jari-jari r adalah K=2.pi.r.
% 
% ==============================================================================
% BUKTI KELILING LINGKARAN (K = 2 * pi * r) DI EMT / MAXIMA
% ==============================================================================
% 1. Bersihkan memori total
>reset();
% 2. Definisikan variabel simbolis t dan konstanta r
>t &= 't; r &= 'r;
% 3. Dalam koordinat polar, jari-jari lingkaran r(t) konstan bernilai r
>rtek &= r;
% 4. Hitung elemen panjang busur (ds) secara simbolis
>dspolar &= trigreduce(radcan(sqrt(rtek^2 + diff(rtek, t)^2)));
>$'ds = dspolar
 %image% TugasAplikom6Adi25030630001-168.png
% // latex: {\it ds}=\left| r\right| 
% 5. Integralkan dari 0 sampai 2*pi untuk mendapatkan keliling total
>Keliling &= integrate(dspolar, t, 0, 2*pi);
>$'K = Keliling
 %image% TugasAplikom6Adi25030630001-169.png
% // latex: K=2\,\pi\,\left| r\right| 
>         
% 
% Berikut adalah contoh menghitung panjang parabola.
>plot2d("x^2",xmin=-1,xmax=1):
 %image% TugasAplikom6Adi25030630001-170.png
>$showev('integrate(sqrt(1+diff(x^2,x)^2),x,-1,1))
 %image% TugasAplikom6Adi25030630001-171.png
% // latex: \int_{-1}^{1}{\sqrt{4\,x^2+1}\;dx}=\frac{{\rm asinh}\; 2+2\,\sqrt{5  }}{2}
>$float(%)
 %image% TugasAplikom6Adi25030630001-172.png
% // latex: \int_{-1.0}^{1.0}{\sqrt{4.0\,x^2+1.0}\;dx}=2.957885715089195
>x=-1:0.2:1; y=x^2; plot2d(x,y);  ...
>  plot2d(x,y,points=1,style="o#",add=1):
 %image% TugasAplikom6Adi25030630001-173.png
> 
% Panjang tersebut dapat dihampiri dengan menggunakan jumlah panjang ruas-ruas garis yang menghubungkan titik-titik pada parabola
% tersebut.
>i=1:cols(x)-1; sum(sqrt((x[i+1]-x[i])^2+(y[i+1]-y[i])^2))
2.95191957027
% Hasilnya mendekati panjang yang dihitung secara eksak. Untuk
% mendapatkan hampiran yang cukup akurat, jarak antar titik dapat
% diperkecil, misalnya 0.1, 0.05, 0.01, dan seterusnya. Cobalah Anda
% ulangi perhitungannya dengan nilai-nilai tersebut.
% 
% ==============================================================================
% PENGHAMPIRAN PANJANG KURVA PARABOLA y = x^2 DENGAN BERBAGAI
% SUB-INTERVAL (h)
% ==============================================================================
% 1. Reset memori agar bersih dari variabel sebelumnya
>reset();
% 2. Eksak (Sebagai pembanding): Integral eksak panjang kurva y = x^2 dari -1 sampai 1
>integrate("sqrt(1 + 4*x^2)", -1, 1)
2.95788571509
% ------------------------------------------------------------------------------
% A. Ulangi dengan h = 0.1
>x = -1:0.1:1; y = x^2;
>i = 1:cols(x)-1; sum(sqrt((x[i+1]-x[i])^2 + (y[i+1]-y[i])^2))
2.95639479497
% ------------------------------------------------------------------------------
% B. Ulangi dengan h = 0.05
>x = -1:0.05:1; y = x^2;
>i = 1:cols(x)-1; sum(sqrt((x[i+1]-x[i])^2 + (y[i+1]-y[i])^2))
2.95751302406
% ------------------------------------------------------------------------------
% C. Ulangi dengan h = 0.01
>x = -1:0.01:1; y = x^2;
>i = 1:cols(x)-1; sum(sqrt((x[i+1]-x[i])^2 + (y[i+1]-y[i])^2))
2.95787080795
% ------------------------------------------------------------------------------
% D. Ulangi dengan h = 0.001 (Menghasilkan hampiran yang sangat akurat)
>x = -1:0.001:1; y = x^2;
>i = 1:cols(x)-1; sum(sqrt((x[i+1]-x[i])^2 + (y[i+1]-y[i])^2))
2.95788556602
>
% ** Koordinat Kartesius
% 
% Berikut diberikan contoh perhitungan panjang kurva menggunakan
% koordinat Kartesius. Kita akan hitung panjang kurva dengan persamaan
% implisit:
% 
% latex: x^3+y^3-3xy=0.
% %image% TugasAplikom6Adi25030630001-174.png
% // latex: x^3+y^3-3xy=0.
>z &= x^3+y^3-3*x*y; $z
 %image% TugasAplikom6Adi25030630001-175.png
% // latex: y^3-3\,x\,y+x^3
>plot2d(z,r=2,level=0,n=100):
 %image% TugasAplikom6Adi25030630001-176.png
% Kita tertarik pada kurva di kuadran pertama.
>plot2d(z,a=0,b=2,c=0,d=2,level=[-10;0],n=100,contourwidth=3,style="/"):
 %image% TugasAplikom6Adi25030630001-177.png
% Kita selesaikan persamaannya untuk x.
>$z with y=l*x, sol &= solve(%,x); $sol
 %image% TugasAplikom6Adi25030630001-178.png
% // latex: \left[ x=\frac{3\,l}{l^3+1} , x=0 \right] 
 %image% TugasAplikom6Adi25030630001-179.png
% Kita gunakan solusi tersebut untuk mendefinisikan fungsi dengan Maxima.
>function f(l) &= rhs(sol[1]); $'f(l)=f(l)
 %image% TugasAplikom6Adi25030630001-180.png
% // latex: f\left(l\right)=\frac{3\,l}{l^3+1}
% Fungsi tersebut juga dapat digunaka untuk menggambar kurvanya. Ingat, bahwa fungsi tersebut adalah nilai x dan nilai y=l*x, yakni
% x=f(l) dan y=l*f(l).
>plot2d(&f(x),&x*f(x),xmin=-0.5,xmax=2,a=0,b=2,c=0,d=2,r=1.5):
 %image% TugasAplikom6Adi25030630001-181.png
% Elemen panjang kurva adalah:
% 
% latex: ds=\sqrt{f'(l)^2+(lf'(l)+f(l))^2}.
% %image% TugasAplikom6Adi25030630001-182.png
% // latex: ds=\sqrt{f'(l)^2+(lf'(l)+f(l))^2}.
>function ds(l) &= ratsimp(sqrt(diff(f(l),l)^2+diff(l*f(l),l)^2)); $'ds(l)=ds(l)
 %image% TugasAplikom6Adi25030630001-183.png
% // latex: {\it ds}\left(l\right)=\frac{\sqrt{9\,l^8+36\,l^6-36\,l^5-36\,l^3+  36\,l^2+9}}{\sqrt{l^{12}+4\,l^9+6\,l^6+4\,l^3+1}}
>$integrate(ds(l),l,0,1)
 %image% TugasAplikom6Adi25030630001-184.png
% // latex: \int_{0}^{1}{\frac{\sqrt{9\,l^8+36\,l^6-36\,l^5-36\,l^3+36\,l^2+9}  }{\sqrt{l^{12}+4\,l^9+6\,l^6+4\,l^3+1}}\;dl}
% Integral tersebut tidak dapat dihitung secara eksak menggunakan Maxima. Kita hitung integral etrsebut secara numerik dengan Euler.
% Karena kurva simetris, kita hitung untuk nilai variabel integrasi dari 0 sampai 1, kemudian hasilnya dikalikan 2. 
>2*integrate("ds(x)",0,1)
4.91748872168
>2*romberg(&ds(x),0,1)// perintah Euler lain untuk menghitung nilai hampiran integral yang sama
4.91748872168
% Perhitungan di datas dapat dilakukan untuk sebarang fungsi x dan y dengan mendefinisikan fungsi EMT, misalnya kita beri nama
% panjangkurva. Fungsi ini selalu memanggil Maxima untuk menurunkan fungsi yang diberikan.
>function panjangkurva(fx,fy,a,b) ...
$ds=mxm("sqrt(diff(@fx,x)^2+diff(@fy,x)^2)");
$return romberg(ds,a,b);
$endfunction
>panjangkurva("x","x^2",-1,1) // cek untuk menghitung panjang kurva parabola sebelumnya
2.95788571509
% Bandingkan dengan nilai eksak di atas.
>2*panjangkurva(mxm("f(x)"),mxm("x*f(x)"),0,1) // cek contoh terakhir, bandingkan hasilnya!
4.91748872168
% [TERLIHAT MEMILIKI HASIL YANG SAMA]
