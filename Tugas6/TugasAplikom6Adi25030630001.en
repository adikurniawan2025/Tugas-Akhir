>$showev('limit((asin(x+h)-asin(x))/h,h,0)) // turunan arcsin(x)
 %image% TugasAplikom6Adi25030630001-094.png
% // latex: \lim_{h\rightarrow 0}{\frac{\arcsin \left(x+h\right)-\arcsin x}{h}}=  \frac{1}{\sqrt{1-x^2}}
% Mengapa hasilnya seperti itu? Tuliskan atau tunjukkan bahwa hasil
% limit tersebut benar, sehingga benar turunan fungsinya benar. Tulis
% penjelasan Anda di komentar ini.
% 
% Penjelasan Analitis Pembuktian Turunan f(x) = arcsin(x):
% 
% 1. Pemisalan dan Fungsi Invers:
%%    Misalkan y = arcsin(x), maka berdasarkan definisi fungsi invers:
%%    x = sin(y)  dengan domain -1 < x < 1 dan range -pi/2 < y < pi/2.
% 
% 2. Turunan Implisit terhadap x:
%%    Turunkan kedua sisi x = sin(y) terhadap x menggunakan aturan
% rantai:
%%    d/dx [x] = d/dx [sin(y)]
%%    1 = cos(y) * (dy/dx)
%%    dy/dx = 1 / cos(y)
% 
% 3. Mengubah cos(y) ke dalam Bentuk x:
%%    Gunakan identitas trigonometri dasar: sin^2(y) + cos^2(y) = 1
%%    cos^2(y) = 1 - sin^2(y)
%%    cos(y) = sqrt(1 - sin^2(y))
% 
%    Karena x = sin(y), maka:
%%    cos(y) = sqrt(1 - x^2)
% 
% 4. Substitusi Kembali:
%%    dy/dx = 1 / sqrt(1 - x^2)
% 
% 5. Hubungan dengan Limit Turunan:
%%    Berdasarkan definisi limit turunan f'(x):
%%    lim_{h->0} (arcsin(x+h) - arcsin(x)) / h = f'(x)
% 
%    Terbukti bahwa nilai limit tersebut adalah 1 / sqrt(1 - x^2).
>$showev('limit((tan(x+h)-tan(x))/h,h,0)) // turunan tan(x)
 %image% TugasAplikom6Adi25030630001-095.png
% // latex: \lim_{h\rightarrow 0}{\frac{\tan \left(x+h\right)-\tan x}{h}}=  \frac{1}{\cos ^2x}
% Mengapa hasilnya seperti itu? Tuliskan atau tunjukkan bahwa hasil
% limit tersebut benar, sehingga benar turunan fungsinya benar. Tulis
% penjelasan Anda di komentar ini.
% 
% Penjelasan Analitis Pembuktian Turunan f(x) = tan(x):
% 
% 1. Definisi Identitas Trigonometri:
%%    f(x) = tan(x) = sin(x) / cos(x)
% 
% 2. Aturan Pembagian Turunan (Quotient Rule):
%%    Jika f(x) = u(x) / v(x), maka f'(x) = (u' * v - u * v') / (v^2)
%%    Dengan:
%%    - u(x) = sin(x)  => u'(x) = cos(x)
%%    - v(x) = cos(x)  => v'(x) = -sin(x)
% 
% 3. Substitusi ke Rumus Turunan:
%%    f'(x) = (cos(x) * cos(x) - sin(x) * (-sin(x))) / cos^2(x)
%%    f'(x) = (cos^2(x) + sin^2(x)) / cos^2(x)
% 
% 4. Identitas Pythagoras Trigonometri:
%%    Karena sin^2(x) + cos^2(x) = 1, maka:
%%    f'(x) = 1 / cos^2(x)  (atau sec^2(x))
% 
% 5. Hubungan dengan Limit Turunan:
%%    Berdasarkan definisi limit turunan f'(x):
%%    lim_{h->0} (tan(x+h) - tan(x)) / h = f'(x)
% 
%    Terbukti bahwa nilai limit tersebut adalah 1 / cos^2(x).
