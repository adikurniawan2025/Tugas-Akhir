 %image% TugasAplikom6Adi25030630001-057.png
% // latex: \lim_{x\rightarrow \infty }{\sin \left(\frac{1}{x}\right)}=0
>plot2d("sin(1/x)",-0.001,0.001):
 %image% TugasAplikom6Adi25030630001-058.png
% * Latihan
% 
% Bukalah buku Kalkulus. Cari dan pilih beberapa (paling sedikit 5 fungsi berbeda
% tipe/bentuk/jenis) fungsi dari buku tersebut, kemudian definisikan di EMT pada
% baris-baris perintah berikut (jika perlu tambahkan lagi). Untuk setiap fungsi, hitung
% nilai limit fungsi tersebut di beberapa nilai dan di tak hingga. Gambar grafik fungsi
% tersebut untuk mengkonfirmasi nilai-nilai limit tersebut.
>
% MENDEFINISIKAN FUNGSI, HUNG LIMIT, DAN PLOT GRAFIK
% 
% 1. FUNGSI TRIGONOMETRI
>$showev('limit(sin(5*x)/(3*x), x, 0))
 %image% TugasAplikom6Adi25030630001-059.png
% // latex: \frac{\lim_{x\rightarrow 0}{\frac{\sin \left(5\,x\right)}{x}}}{3}=  \frac{5}{3}
>$showev('limit(sin(5*x)/(3*x), x, inf))
 %image% TugasAplikom6Adi25030630001-060.png
% // latex: \frac{\lim_{x\rightarrow \infty }{\frac{\sin \left(5\,x\right)}{x}}  }{3}=0
>aspect(1.5); plot2d("sin(5*x)/(3*x)", -pi, pi); plot2d(0, 5/3, >points, style="ow", >add):
 %image% TugasAplikom6Adi25030630001-061.png
% 2. FUNGSI RASIONAL
> $showev('limit((x^2-4)/(x-2), x, 2))
 %image% TugasAplikom6Adi25030630001-062.png
% // latex: \lim_{x\rightarrow 2}{\frac{x^2-4}{x-2}}=4
>$showev('limit((x^2-4)/(x-2), x, inf))
 %image% TugasAplikom6Adi25030630001-063.png
% // latex: \lim_{x\rightarrow \infty }{\frac{x^2-4}{x-2}}=\infty 
