% * Kalkulus dengan EMT
% 
% Materi Kalkulus mencakup di antaranya:
% 
% - Fungsi (fungsi aljabar, trigonometri, eksponensial, logaritma, komposisi fungsi)
%% - Limit Fungsi,
%% - Turunan Fungsi,
%% - Integral Tak Tentu,
%% - Integral Tentu dan Aplikasinya,
%% - Barisan dan Deret (kekonvergenan barisan dan deret).
% 
% EMT (bersama Maxima) dapat digunakan untuk melakukan semua perhitungan di dalam kalkulus, baik secara numerik maupun analitik
% (eksak).
% 
% ** Mendefinisikan Fungsi
% 
% Terdapat beberapa cara mendefinisikan fungsi pada EMT, yakni:
% 
% - Menggunakan format nama_fungsi := rumus fungsi (untuk fungsi numerik),
%% - Menggunakan format nama_fungsi &= rumus fungsi (untuk fungsi simbolik, namun dapat dihitung secara numerik),
%% - Menggunakan format nama_fungsi &&= rumus fungsi (untuk fungsi simbolik murni, tidak dapat dihitung langsung),
%% - Fungsi sebagai program EMT.
% 
% Setiap format harus diawali dengan perintah function (bukan sebagai ekspresi).
% 
% Berikut adalah adalah beberapa contoh cara mendefinisikan fungsi:
% 
% latex: f(x)=2x^2+e^{\sin(x)}.
>function f(x) := 2*x^2+exp(sin(x)) // fungsi numerik
>f(0), f(1), f(pi)
1
4.31977682472
20.7392088022
>f(a) // tidak dapat dihitung nilainya
Variable or function a not found.
Error in:
f(a) // tidak dapat dihitung nilainya ...
   ^
% Silakan Anda plot kurva fungsi di atas!
> aspect(1.5); plot2d("f(x)", -pi, pi):
 %image% TugasAplikom6Adi25030630001-001.png
% Berikutnya kita definisikan fungsi:
% 
% latex: g(x)=\frac{\sqrt{x^2-3x}}{x+1}.
% %image% TugasAplikom6Adi25030630001-002.png
% // latex: g(x)=\frac{\sqrt{x^2-3x}}{x+1}.
>function g(x) := sqrt(x^2-3*x)/(x+1)
>g(3)
0
>g(0)
0
>g(1) // kompleks, tidak dapat dihitung oleh fungsi numerik
Floating point error!
Error in sqrt
Try "trace errors" to inspect local variables after errors.
g:
    useglobal; return sqrt(x^2-3*x)/(x+1) 
Error in:
g(1) // kompleks, tidak dapat dihitung oleh fungsi numerik ...
    ^
% Silakan Anda plot kurva fungsi di atas!
>aspect(1.5); plot2d("g(x)", 3, 10):
 %image% TugasAplikom6Adi25030630001-003.png
>
>f(g(5)) // komposisi fungsi
2.20920171961
>g(f(5))
0.950898070639
>function h(x) := f(g(x)) // definisi komposisi fungsi 
>h(5) // sama dengan f(g(5))
2.20920171961
>
% Silakan Anda plot kurva fungsi komposisi fungsi f dan g:
% 
% latex: h(x)=f(g(x))
% 
% dan
% 
% latex: u(x)=g(f(x))
% 
% bersama-sama kurva fungsi f dan g dalam satu bidang koordinat.
>
>function f(x) := 2*x^2+exp(sin(x))
>function g(x) := sqrt(x^2-3*x)/(x+1)
>function h(x) := f(g(x))
>function u(x) := g(f(x))
>f(g(5))
2.20920171961
>g(f(5))
0.950898070639
>h(5)
2.20920171961
>aspect(1.5); plot2d(["f(x)","g(x)","h(x)","u(x)"], 3, 10, color=[blue,red,green,orange]):
 %image% TugasAplikom6Adi25030630001-004.png
> 
>f(0:10) // nilai-nilai f(0), f(1), f(2), ..., f(10)
[1,  4.31978,  10.4826,  19.1516,  32.4692,  50.3833,  72.7562,
99.929,  130.69,  163.51,  200.58]
>fmap(0:10) // sama dengan f(0:10), berlaku untuk semua fungsi
[1,  4.31978,  10.4826,  19.1516,  32.4692,  50.3833,  72.7562,
99.929,  130.69,  163.51,  200.58]
>gmap(200:210)
[0.987534,  0.987596,  0.987657,  0.987718,  0.987778,  0.987837,
0.987896,  0.987954,  0.988012,  0.988069,  0.988126]
% Misalkan kita akan mendefinisikan fungsi
% 
% latex: f(x) = \begin{cases} x^3 & x>0 \\ x^2 & x\le 0. \end{cases}
% %image% TugasAplikom6Adi25030630001-005.png
% // latex: f(x) = \begin{cases} x^3 & x>0 \\ x^2 & x\le 0. \end{cases}
% 
% Fungsi tersebut tidak dapat didefinisikan sebagai fungsi numerik
% secara "inline" menggunakan format :=, melainkan didefinisikan sebagai
% program. Perhatikan, kata "map" digunakan agar fungsi dapat menerima
% vektor sebagai input, dan hasilnya berupa vektor. Jika tanpa kata
% "map" fungsinya hanya dapat menerima input satu nilai.
>function map f(x) ...
$  if x>0 then return x^3
$  else return x^2
$  endif;
$endfunction
>f(1)
1
>f(-2)
4
>f(-5:5)
[25,  16,  9,  4,  1,  0,  1,  8,  27,  64,  125]
>aspect(1.5); plot2d("f(x)",-5,5):
 %image% TugasAplikom6Adi25030630001-006.png
>function f(x) &= 2*E^x // fungsi simbolik

                                    x
                                 2 E

>$f(a) // nilai fungsi secara simbolik
 %image% TugasAplikom6Adi25030630001-007.png
% // latex: 2\,e^{a}
>f(E) // nilai fungsi berupa bilangan desimal
30.308524483
>$f(E), $float(%)
 %image% TugasAplikom6Adi25030630001-008.png
% // latex: 30.30852448295852
 %image% TugasAplikom6Adi25030630001-009.png
>function g(x) &= 3*x+1

                               3 x + 1

>function h(x) &= f(g(x)) // komposisi fungsi

                                 3 x + 1
                              2 E

>plot2d("h(x)",-1,1):
 %image% TugasAplikom6Adi25030630001-010.png
>
% * Latihan
% 
% Bukalah buku Kalkulus. Cari dan pilih beberapa (paling sedikit 5
% fungsi berbeda tipe/bentuk/jenis) fungsi dari buku tersebut, kemudian
% definisikan fungsi-fungsi tersebut dan komposisinya di EMT pada
% baris-baris perintah berikut (jika perlu tambahkan lagi). Untuk setiap
% fungsi, hitung beberapa nilainya, baik untuk satu nilai maupun vektor.
% Gambar grafik fungsi-fungsi tersebut dan komposisi-komposisi 2 fungsi.
% 
% Juga, carilah fungsi beberapa (dua) variabel. Lakukan hal sama seperti
% di atas.
% 
% 
%  MENDEFINISIKAN 5 FUNGSI BERBEDA TIPE 
>function f1(x) := x^3 - 4*x            // 1. Fungsi Polinomial
>function f2(x) := (x^2 - 1)/(x^2 + 1)  // 2. Fungsi Rasional
>function f3(x) := sin(2*x) + cos(x)    // 3. Fungsi Trigonometri
>function f4(x) := exp(-x^2)            // 4. Fungsi Eksponensial
>function f5(x) := sqrt(x^2 + 9)        // 5. Fungsi Akar/Irrasional                
% HITUNG BEBERAPA NILAI (SATU NILAI DAN VEKTOR) 
>f1(2), f2(0), f3(pi/4), f4(1), f5(4)
0
-1
1.70710678119
0.367879441171
5
>f1(-2:2)
[0,  3,  0,  -3,  0]
>f2(0:5)
[-1,  0,  0.6,  0.8,  0.882353,  0.923077]
>f3(linspace(0,pi,5))
[1,  1.76007,  0.896802,  -0.896802,  -1.76007,  -1]
>f4(-2:2)
[0.0183156,  0.367879,  1,  0.367879,  0.0183156]
>f5(0:4)
[3,  3.16228,  3.60555,  4.24264,  5]
% KOMPOSISI DUA FUNGSI
% 
% Mendefinisikan komposisi h1(x) = f1(f3(x)) dan h2(x) = f4(f5(x))
>function h1(x) := f1(f3(x))
>function h2(x) := f4(f5(x))
% Menghitung nilai komposisi pada satu titik dan vektor
>h1(pi/6), h2(2)
-1.73205080757
2.26032940698e-06
>h1(linspace(-pi,pi,5))
[3,  -1.09341,  0.565292,  -1.58783,  2.86595,  3]
% MENGGAMBAR GRAFIK FUNGSI DAN KOMPOSISI FUNGSI
>aspect(1.5); plot2d(["f1(x)","f3(x)","h1(x)"], -pi, pi, color=[blue,red,green]):
 %image% TugasAplikom6Adi25030630001-011.png
>aspect(1.5); plot2d(["f4(x)","f5(x)","h2(x)"], -3, 3, color=[blue,red,green]):
 %image% TugasAplikom6Adi25030630001-012.png
% FUNGSI DUA VARIABEL 
>function g2v(x,y) := x^2 + y^2 - 4
>g2v(2,3)
9
>g2v([1,2],[3,4])
[6,  16]
>plot3d("g2v(x,y)", r=3):
 %image% TugasAplikom6Adi25030630001-013.png
>     
% 
% * Menghitung Limit
% 
% Perhitungan limit pada EMT dapat dilakukan dengan menggunakan fungsi Maxima, yakni "limit".
% Fungsi "limit" dapat digunakan untuk menghitung limit fungsi dalam bentuk ekspresi maupun fungsi
% yang sudah didefinisikan sebelumnya. Nilai limit dapat dihitung pada sebarang nilai atau pada tak
% hingga (-inf, minf, dan inf). Limit kiri dan limit kanan juga dapat dihitung, dengan cara memberi
% opsi "plus" atau "minus". Hasil limit dapat berupa nilai, "und" (tak definisi), "ind" (tak tentu
% namun terbatas), "infinity" (kompleks tak hingga).
% 
% Perhatikan beberapa contoh berikut. Perhatikan cara menampilkan perhitungan secara lengkap, tidak
% hanya menampilkan hasilnya saja.
>$showev('limit(sqrt(x^2-3*x)/(x+1),x,inf))
 %image% TugasAplikom6Adi25030630001-014.png
% // latex: \lim_{x\rightarrow \infty }{\frac{\sqrt{x^2-3\,x}}{x+1}}=1
>$limit((x^3-13*x^2+51*x-63)/(x^3-4*x^2-3*x+18),x,3)
 %image% TugasAplikom6Adi25030630001-015.png
% // latex: -\frac{4}{5}
% maxima: 'limit((x^3-13*x^2+51*x-63)/(x^3-4*x^2-3*x+18),x,3)=limit((x^3-13*x^2+51*x-63)/(x^3-4*x^2-3*x+18),x,3)
% 
% Fungsi tersebut diskontinu di titik x=3. Berikut adalah grafik fungsinya.
>aspect(1.5); plot2d("(x^3-13*x^2+51*x-63)/(x^3-4*x^2-3*x+18)",0,4); plot2d(3,-4/5,>points,style="ow",>add):
 %image% TugasAplikom6Adi25030630001-016.png
>$limit(2*x*sin(x)/(1-cos(x)),x,0)
 %image% TugasAplikom6Adi25030630001-017.png
% // latex: 4
% maxima: 'limit(2*x*sin(x)/(1-cos(x)),x,0)=limit(2*x*sin(x)/(1-cos(x)),x,0)
% 
% Fungsi tersebut diskontinu di titik x=0. Berikut adalah grafik fungsinya.
>plot2d("2*x*sin(x)/(1-cos(x))",-pi,pi); plot2d(0,4,>points,style="ow",>add):
 %image% TugasAplikom6Adi25030630001-018.png
>$limit(cot(7*h)/cot(5*h),h,0)
 %image% TugasAplikom6Adi25030630001-019.png
% // latex: \frac{5}{7}
% maxima: showev('limit(cot(7*h)/cot(5*h),h,0))
% 
% Fungsi tersebut juga diskontinu (karena tidak terdefinisi) di x=0. Berikut adalah grafiknya.
>plot2d("cot(7*x)/cot(5*x)",-0.001,0.001); plot2d(0,5/7,>points,style="ow",>add):
 %image% TugasAplikom6Adi25030630001-020.png
>$showev('limit(((x/8)^(1/3)-1)/(x-8),x,8))
 %image% TugasAplikom6Adi25030630001-021.png
% // latex: \lim_{x\rightarrow 8}{\frac{\frac{x^{\frac{1}{3}}}{2}-1}{x-8}}=  \frac{1}{24}
% Tunjukkan limit tersebut dengan grafik, seperti contoh-contoh sebelumnya.
>plot2d("((x/8)^(1/3)-1)/(x-8)", 0, 16); plot2d(8, 1/24, >points, style="ow", >add):
 %image% TugasAplikom6Adi25030630001-022.png
>$showev('limit(1/(2*x-1),x,0))
 %image% TugasAplikom6Adi25030630001-023.png
% // latex: \lim_{x\rightarrow 0}{\frac{1}{2\,x-1}}=-1
% Tunjukkan limit tersebut dengan grafik, seperti contoh-contoh sebelumnya.
>plot2d("1/(2*x-1)", -1, 1); plot2d(0, -1, >points, style="ow", >add):
 %image% TugasAplikom6Adi25030630001-024.png
>$showev('limit((x^2-3*x-10)/(x-5),x,5))
 %image% TugasAplikom6Adi25030630001-025.png
% // latex: \lim_{x\rightarrow 5}{\frac{x^2-3\,x-10}{x-5}}=7
% Tunjukkan limit tersebut dengan grafik, seperti contoh-contoh sebelumnya.
>plot2d("(x^2-3*x-10)/(x-5)", 0, 10); plot2d(5, 7, >points, style="ow", >add):
 %image% TugasAplikom6Adi25030630001-026.png
>$showev('limit(sqrt(x^2+x)-x,x,inf))
 %image% TugasAplikom6Adi25030630001-027.png
% // latex: \lim_{x\rightarrow \infty }{\sqrt{x^2+x}-x}=\frac{1}{2}
% Tunjukkan limit tersebut dengan grafik, seperti contoh-contoh sebelumnya.
>plot2d("sqrt(x^2+x)-x", 0, 50):
 %image% TugasAplikom6Adi25030630001-028.png
>$showev('limit(abs(x-1)/(x-1),x,1,minus))
 %image% TugasAplikom6Adi25030630001-029.png
% // latex: \lim_{x\uparrow 1}{\frac{\left| x-1\right| }{x-1}}=-1
% Hitung limit di atas untuk x menuju 1 dari kanan.
%% Tunjukkan limit tersebut dengan grafik, seperti contoh-contoh sebelumnya.
>$showev('limit(abs(x-1)/(x-1),x,1,plus))
 %image% TugasAplikom6Adi25030630001-030.png
% // latex: \lim_{x\downarrow 1}{\frac{\left| x-1\right| }{x-1}}=1
>plot2d("abs(x-1)/(x-1)", -1, 3); plot2d(1, -1, >points, style="ow", >add); plot2d(1, 1, >points, style="ow", >add):
 %image% TugasAplikom6Adi25030630001-031.png
>$showev('limit(sin(x)/x,x,0))
 %image% TugasAplikom6Adi25030630001-032.png
% // latex: \lim_{x\rightarrow 0}{\frac{\sin x}{x}}=1
>plot2d("sin(x)/x",-pi,pi); plot2d(0,1,>points,style="ow",>add):
 %image% TugasAplikom6Adi25030630001-033.png
>$showev('limit(sin(x^3)/x,x,0))
 %image% TugasAplikom6Adi25030630001-034.png
% // latex: \lim_{x\rightarrow 0}{\frac{\sin x^3}{x}}=0
% Tunjukkan limit tersebut dengan grafik, seperti contoh-contoh sebelumnya.
>plot2d("sin(x^3)/x", -pi, pi); plot2d(0, 0, >points, style="ow", >add):
 %image% TugasAplikom6Adi25030630001-035.png
>$showev('limit(log(x), x, minf))
 %image% TugasAplikom6Adi25030630001-036.png
% // latex: \lim_{x\rightarrow  -\infty }{\log x}={\it infinity}
>$showev('limit((-2)^x,x, inf))
 %image% TugasAplikom6Adi25030630001-037.png
% // latex: \lim_{x\rightarrow \infty }{\left(-2\right)^{x}}={\it infinity}
>$showev('limit(t-sqrt(2-t),t,2,minus))
 %image% TugasAplikom6Adi25030630001-038.png
% // latex: \lim_{t\uparrow 2}{t-\sqrt{2-t}}=2
>$showev('limit(t-sqrt(2-t),t,2,plus))
 %image% TugasAplikom6Adi25030630001-039.png
% // latex: \lim_{t\downarrow 2}{t-\sqrt{2-t}}=2
>$showev('limit(t-sqrt(2-t),t,5,plus)) // Perhatikan hasilnya
 %image% TugasAplikom6Adi25030630001-040.png
% // latex: \lim_{t\downarrow 5}{t-\sqrt{2-t}}=5-\sqrt{3}\,i
>plot2d("x-sqrt(2-x)",0,2):
 %image% TugasAplikom6Adi25030630001-041.png
>$showev('limit((x^2-9)/(2*x^2-5*x-3),x,3))
 %image% TugasAplikom6Adi25030630001-042.png
% // latex: \lim_{x\rightarrow 3}{\frac{x^2-9}{2\,x^2-5\,x-3}}=\frac{6}{7}
